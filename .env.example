# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# Required for real extraction. Without it the app runs in demo mode (canned result).
ANTHROPIC_API_KEY=

# Model used for extraction. Default is the current Opus.
EXTRACT_MODEL=claude-opus-5-5

# Force demo mode even when a key is set (useful for UI work): 1 or 0
MOCK_EXTRACT=0

# Server-side refusal fallback. 1 = on (default), 0 = off.
ENABLE_FALLBACKS=1

# Caps that protect the API bill.
DAILY_CAP=500
HOURLY_CAP_PER_FAMILY=20
HOURLY_CAP_PER_IP=60

# --- Family storage (pick one) ---
# Local development: a folder for families/<id>.json
LOCAL_DATA_DIR=./data
# Vercel: a private Blob store token (Storage → Blob). Families live under parentdesk/families/.
BLOB_READ_WRITE_TOKEN=

# --- E-mail forwarding (optional, see integrations/) ---
# The domain whose addresses route to /api/inbound, e.g. in.example.com. Unset = feature hidden.
INBOUND_DOMAIN=
# Shared secret the mail router sends as "Authorization: Bearer <secret>".
INBOUND_SECRET=

# --- Gmail auto-collect (optional) ---
# OAuth client from Google Cloud (Web application; redirect URI <origin>/api/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 64 hex characters (openssl rand -hex 32). Seals the Gmail refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=
# Vercel sends this as "Authorization: Bearer" to /api/cron/scan (the daily inbox check).
CRON_SECRET=

# --- Billing (optional; without it every family has the Family plan for free) ---
# Stripe secret key (sk_live_... or sk_test_...), the webhook signing secret of the
# endpoint <origin>/api/billing/webhook, and the price ids of the Family plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# What the Free plan allows once billing is on, and the prices shown on the pricing page.
FREE_MONTHLY_NOTICES=15
FREE_MAX_CHILDREN=1
NEXT_PUBLIC_PRICE_MONTHLY=$4.99
NEXT_PUBLIC_PRICE_YEARLY=$39

# --- Weekly summary e-mail (optional) ---
# Resend API key and the verified sender, e.g. "ParentDesk <digest@yourdomain.com>".
RESEND_API_KEY=
DIGEST_FROM=

# --- Admin console at /admin (optional) ---
# At least 16 characters (openssl rand -hex 24). Unset = the console is off.
ADMIN_TOKEN=

# --- Class rooms for teachers ---
# Posts a teacher may publish per month (default 100). Rooms are always on.
TEACHER_MONTHLY_POSTS=


# Models for the assistant (questions, reply drafts) and the inbox classifier.
ASSIST_MODEL=claude-sonnet-5-5
CLASSIFY_MODEL=claude-haiku-5-5

# Public origin used in metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://parentdesk-app.vercel.app
