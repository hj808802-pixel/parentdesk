# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# Required for real extraction. Without it the app runs in demo mode (canned result).
ANTHROPIC_API_KEY=

# Model used for extraction. Default is the current Opus.
EXTRACT_MODEL=claude-opus-5-5

# Force demo mode even when a key is set (useful for UI work): 1 or 0
MOCK_EXTRACT=0

# Server-side refusal fallback. 1 = on (default), 0 = off.
ENABLE_FALLBACKS=1

# Caps that protect the API bill.
DAILY_CAP=500
HOURLY_CAP_PER_FAMILY=20
HOURLY_CAP_PER_IP=60

# --- Family storage (pick one) ---
# Local development: a folder for families/<id>.json
LOCAL_DATA_DIR=./data
# Vercel: a private Blob store token (Storage → Blob). Families live under parentdesk/families/.
BLOB_READ_WRITE_TOKEN=

# --- E-mail forwarding (optional, see integrations/) ---
# The domain whose addresses route to /api/inbound, e.g. in.example.com. Unset = feature hidden.
INBOUND_DOMAIN=
# Shared secret the mail router sends as "Authorization: Bearer <secret>".
INBOUND_SECRET=

# Public origin used in metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://parentdesk-app.vercel.app
